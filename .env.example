# Copy to .env.local and fill in values. Never commit real secrets.

# Canonical site URL (production: https://www.slabvaultfi.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: override token mint in data/site.json for Dexscreener stats
# NEXT_PUBLIC_TOKEN_CA=

# Marketplace PostgreSQL (optional — omit to use demo listings from data/slabs.json)
# DATABASE_URL=postgresql://user:pass@host:5432/slabvaultfi

# Solana RPC (optional; defaults to public mainnet-beta)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Admin dashboard (NextAuth credentials)
# ADMIN_PASSWORD=
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
