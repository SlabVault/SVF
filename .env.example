# Cursor SDK — orchestration scripts (scripts/cursor-sdk/*). Never commit real keys.
# Used by: npm run orchestrate:investigate -- --dispatch
#          npm run orchestrate:next -- --dispatch
# Create at: https://cursor.com/dashboard/cloud-agents
# CURSOR_API_KEY=

# Canonical site URL (production). Used for Open Graph, sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://slabvault.xyz

# Optional: override Solana token mint from data/site.json
# NEXT_PUBLIC_TOKEN_CA=

# Client wallet + ConnectionProvider (browser). Required for reliable balance reads.
# Public mainnet-beta is rate-limited and often returns 403 — use Helius or QuickNode.
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key
# Legacy alias (still supported):
# NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Server-side RPC (payment verify, tx simulation, /api/trade/tx/*).
# Falls back to Helius when HELIUS_API_KEY is set, then NEXT_PUBLIC_SOLANA_RPC_URL.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key

# Treasury + token config
# TREASURY_WALLET_ADDRESS=2oRZe7z9Jx3rpoUWuidjGhpX9mxxhtps2JqQtdxLfHwg
# DEPLOYER_WALLET_ADDRESS=CWqc6DQhHxdnDSwrjG3LGnyWPQ3dRNfCY5umvTj8NBE3
# SVF_TOKEN_MINT=6ZxRa2CWtAcWKb58RMJABuiUYWu9o4oM76QCyMVLpump
# SERVER_WALLET_SECRET=[1,2,3,...]

# --- Database (marketplace checkout) ---
#
# LOCAL DEV - use a direct PostgreSQL URL (recommended if you already run Postgres):
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slabvault
#
# Alternative LOCAL - Prisma managed local Postgres (run in a separate terminal first):
#   npx prisma dev
#   Then use the prisma+postgres:// URL printed by the CLI (often localhost:51213).
#   DATABASE_URL=prisma+postgres://localhost:51213/?api_key=...
#
# Note: prisma+postgres:// without `npx prisma dev` running will fail for db push / the app.
#
# PRODUCTION - direct URL for migrations; Accelerate proxy for serverless runtimes:
#   DATABASE_URL=postgresql://user:pass@host:5432/dbname
#   DATABASE_URL=prisma+postgres://accelerate.prisma-data.net/?api_key=...
#
# DATABASE_URL=

# NextAuth / admin (if using admin dashboard)
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=https://slabvault.xyz
ADMIN_PASSWORD=change-me

# Optional dedicated bearer token for /api/sync.
# If omitted, /api/sync bearer auth falls back to ADMIN_PASSWORD.
# SYNC_API_TOKEN=change-me

# Protects cron-only routes:
# - POST /api/sync
# - POST /api/cron/expire-reservations
# Vercel cron must send: Authorization: Bearer CRON_SECRET
CRON_SECRET=change-me

# Require signed wallet challenge for POST /api/marketplace/reserve.
# Defaults to required in production; set false to disable during rollout.
# RESERVE_REQUIRE_WALLET_CHALLENGE=true

# Require wallet-signed access for buyer transaction reads.
# Defaults to required in production; set false to disable during rollout.
# TRANSACTION_ACCESS_REQUIRE_WALLET_SIGNATURE=true

# Durable API rate limiting (Upstash Redis REST). When both vars are set,
# lib/security.ts uses Upstash before falling back to in-memory limits.
# Without them, each serverless instance keeps its own in-memory counters.
# KV_REST_API_URL=https://your-upstash-endpoint.upstash.io
# KV_REST_API_TOKEN=your-upstash-token

# Discover aggregator (/discover) — ARCHIVED (May 2026). Route redirects to /trade.
# DISCOVER_AGGREGATOR_ENABLED is ignored; sync scripts remain (npm run sync:discover).
# See docs/discover-setup.md (ARCHIVED).

# RWA trading desk (/trade) — Tensor fork strategy (see docs/integrations/rwa-trading-platform.md).
# Defaults to enabled in dev; set true in production to ship the trade route.
# TRADE_PLATFORM_ENABLED=true
# Legacy alias: RWA_TRADE_ENABLED=true

# --- Trade read path (MVP) ---
#
# PRIMARY: partner ingest — DB → API → JSON seed; CC scrape is fallback-only on page loads.
#   npm run sync:discover   # refreshes data/external-listings.json + upserts ExternalListing when DATABASE_URL is set
#   DATABASE_URL=postgresql://...   # direct Postgres (recommended for upserts)
#   DATABASE_URL=prisma+postgres://...   # only with `npx prisma dev` running
#   PARTNER_LIVE_SCRAPE_ENABLED=true  # allow CC live scrape fallback when DB/API/JSON empty or stale (not every SSR)
#
# Partner ingest webhooks (pre-ship — routes not wired yet).
# When enabled, inbound partner webhooks require Authorization: Bearer <PARTNER_WEBHOOK_SECRET>.
# PARTNER_WEBHOOK_ENABLED=false
# PARTNER_WEBHOOK_SECRET=change-me
#
# PRIMARY: Helius DAS — cert↔mint resolution and collection asset fallback.
HELIUS_API_KEY=your-helius-api-key
# Optional Helius RPC override (defaults to mainnet.helius-rpc.com with API key).
# HELIUS_RPC_URL=

# OPTIONAL SHORTCUT (deprecated for MVP read path): Tensor REST API for enriched ME depth / stats.
# Not required when partner ingest + on-chain TCM settlement are wired.
# Request key: https://docs.tensor.trade/trade/api-and-sdk
# TENSOR_API_KEY=
# Comma-separated Tensor collection slugs — only used when TENSOR_API_KEY is set.
# TENSOR_CC_COLLECTION_SLUGS=collector_crypt
# REST base (tensor-hq/marketplace-nextjs-template uses api.mainnet.tensordev.io).
# TENSOR_API_BASE_URL=https://api.mainnet.tensordev.io

# Phase 2–3 — list vault slabs / bids via Tensor SDK + on-chain programs (staging only; prod must stay false).
# Requires wallet flows + program CPI; do not enable until broker PDA ops + Phase 2 reviewed.
# TENSOR_TRADE_WRITE_ENABLED=false
# Client mirror for trade panel / modal gates (staging only).
# NEXT_PUBLIC_TENSOR_TRADE_WRITE_ENABLED=false

# Require signed wallet challenge on GET /api/trade/tx/* (anti-griefing).
# Default off; set true after client passes challengeId + walletSignature on buy (and other tx routes).
# TRADE_TX_REQUIRE_WALLET_CHALLENGE=true

# Optional origin gate on GET /api/trade/tx/* (buy/list/bid/delist builders).
# When true, requireTrustedTensorTxOrigin rejects requests whose Origin/Referer
# is not in getTrustedOrigins() (NEXT_PUBLIC_SITE_URL, NEXTAUTH_URL; localhost in dev).
# Default off. Enable in production after staging verifies in-app wallet flows only.
# Wired on all /api/trade/tx/* routes (buy/list/bid/delist/cancel-bid).
# TENSOR_TX_REQUIRE_TRUSTED_ORIGIN=false

# On-chain trade stack (/trade) — Tensor mainnet programs + SVF broker (see docs/integrations/onchain-trade-stack.md).
# UI layout reference: https://github.com/tensor-hq/marketplace-nextjs-template
# SVF_ONCHAIN_CLUSTER=mainnet-beta
# Broker fee recipient for Tensor Fees program (defaults to data/site.json treasury).
# SVF_BROKER_PUBKEY=
# Target broker bps for ops preview only — configure on-chain via tensor-foundation/fees.
# SVF_BROKER_FEE_BPS=100
# Set after devnet deploy of programs/slabvault-broker (placeholder until audit).
# SLABVAULT_BROKER_PROGRAM_ID=
