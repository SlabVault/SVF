{
  "name": "slabvaultfi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:clean": "npm run clean:next && next dev --webpack",
    "dev:webpack": "next dev --webpack",
    "clean:next": "tsx scripts/clean-next.ts",
    "build": "prisma generate && next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx scripts/run-tests.ts",
    "sync": "tsx scripts/sync-data.ts",
    "sync:discover": "tsx scripts/sync-external-listings.ts",
    "check:phygitals-seed": "tsx scripts/check-phygitals-seed.ts",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:preflight": "tsx scripts/db-preflight.ts",
    "db:preflight:warn": "tsx scripts/db-preflight.ts --warn-only",
    "db:preflight:json": "tsx scripts/db-preflight.ts --json",
    "db:baseline:plan": "tsx scripts/db-baseline-plan.ts",
    "db:baseline:plan:json": "tsx scripts/db-baseline-plan.ts --json",
    "db:repair:payment-split:plan": "tsx scripts/db-repair-payment-split-plan.ts",
    "db:repair:payment-split:plan:json": "tsx scripts/db-repair-payment-split-plan.ts --json",
    "tx:reconcile": "tsx scripts/reconcile-transactions.ts",
    "dev:turbopack": "next dev",
    "ops:env": "tsx scripts/check-env-contract.ts",
    "ops:env:production": "tsx scripts/check-env-contract.ts --production",
    "ops:rotation:check": "tsx scripts/ops-secret-rotation-checklist.ts",
    "ops:verify": "tsx scripts/ops-verify.ts",
    "ops:check": "npm run ops:env:production && npm run ops:verify",
    "test:api": "tsx --test \"tests/api-*.test.ts\"",
    "test:guardrails": "tsx --test \"tests/api-*-guardrails.test.ts\" \"tests/api-trade-tx-guardrails.test.ts\" \"tests/trade-staging-guardrails.test.ts\" \"tests/check-env-contract.test.ts\" \"tests/env-leak-guardrails.test.ts\" \"tests/http-auth.test.ts\" \"tests/partner-webhook-auth.test.ts\" \"tests/wallet-connect-ux.test.ts\" \"tests/proxy-rate-limit.test.ts\" \"tests/security-rate-limit.test.ts\"",
    "perf:check": "tsx --test tests/perf-hygiene.test.ts",
    "qa:local": "npm run lint && npm run test:guardrails && npm run test:api",
    "qa:ci": "npm run lint && npm run test && npm run build",
    "e2e:smoke": "tsx scripts/e2e-smoke.ts",
    "orchestrate:investigate": "tsx scripts/cursor-sdk/investigate-progress.ts --report-only",
    "orchestrate:lanes": "tsx scripts/cursor-sdk/backlog-lanes.ts",
    "orchestrate:next": "tsx scripts/cursor-sdk/autonomous-loop.ts",
    "orchestrate:dry-run": "tsx scripts/cursor-sdk/autonomous-loop.ts --dry-run --lane trade",
    "orchestrate:dispatch": "tsx scripts/cursor-sdk/autonomous-loop.ts --lane trade --dispatch",
    "orchestrate:loop": "tsx scripts/cursor-sdk/loop-runner.ts --once --dry-run",
    "orchestrate:loop:run": "tsx scripts/cursor-sdk/loop-runner.ts --dispatch",
    "cursor:investigate": "tsx scripts/cursor-sdk/investigate-progress.ts",
    "cursor:parallel": "tsx scripts/cursor-sdk/parallel-lanes.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@coral-xyz/anchor": "^0.32.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-solflare": "^0.6.33",
    "@solana/web3.js": "^1.98.4",
    "@tensor-oss/tcomp-sdk": "^6.0.0",
    "@tensor-oss/tensorswap-sdk": "^4.5.0",
    "axios": "^1.16.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cursor/sdk": "^1.0.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "typescript": "^5"
  }
}
